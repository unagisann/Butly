{
  "schema_version": 1,
  "dataset_id": "ja-dialogue-ab-prompts-v1",
  "locale": "ja",
  "purpose": "本番対話に近い日本語入力で、intent_gated と candidates のRAG注入コストおよび応答品質を比較する。",
  "recommended_protocol": {
    "policies": [
      "intent_gated",
      "candidates"
    ],
    "temperature": 0.0,
    "instance_strategy": "memory_seedから同一内容のインスタンスを2つ作り、各policyへ同じpromptを独立に入力する。",
    "primary_metrics": [
      "rag_trigger_rate",
      "prompt_tokens",
      "latency_ms",
      "injected_card_ids",
      "target_fact_recall"
    ],
    "human_review": [
      "無関係な過去の記憶を持ち出していないか",
      "個人情報を唐突に復唱していないか",
      "必要な記憶を自然に利用しているか",
      "回答が記憶に引っ張られすぎていないか"
    ]
  },
