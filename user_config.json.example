{
    "_comment": [
        "Butly ユーザー設定ファイル",
        "config.py のデフォルト値をオーバーライドします。",
        "",
        "■ Phase 2 新形式: connection + model_name のペアで Provider を決定。",
        "  例: \"chat\": {\"connection\": \"openai\", \"model_name\": \"gpt-4o\"}",
        "",
        "■ Built-in connection (常駐):",
        "  google  : Gemini native       (GEMINI_API_KEY / GOOGLE_API_KEY)",
        "  openai  : OpenAI Chat / Embed (OPENAI_API_KEY, OPENAI_BASE_URL で proxy 可)",
        "  xai     : xAI Grok (OpenAI 互換, XAI_API_KEY)",
        "  ollama  : Ollama local (OLLAMA_BASE_URL, 認証不要)",
        "",
        "■ User 定義 connection は LLM_CONNECTIONS で追加 (下の Groq 例参照)。",
        "  Groq / Together / DeepInfra / OpenRouter などの OpenAI 互換 provider は",
        "  Connection エントリだけで使えます (Provider クラス追加不要)。",
        "",
        "■ 旧形式 (model_name only) も互換動作: prefix から connection を自動推定。",
        "  例: \"chat\": {\"model_name\": \"gpt-4o\"} → connection=openai に推定",
        "",
        "■ 各ロールで異なる connection を混在させることも可能。",
        "  例: chat=openai, embedding=google, gatekeeper=ollama",
        "",
        "■ APIキーは設定画面(LLMプロバイダー タブ)から保存できます。",
        "■ OpenAI reasoning モデル (o1/o3/o4) は reasoning_effort を設定可能。"
    ],

    "LLM_PROVIDERS": {
        "ollama": {
            "base_url": "http://localhost:11434"
        }
    },

    "_LLM_CONNECTIONS_example": [
        {
            "_comment": "Groq (OpenAI 互換) を Butly に追加する例。このキーを LLM_CONNECTIONS にリネームして使用。",
            "id": "groq",
            "protocol": "openai_compat",
            "base_url": "https://api.groq.com/openai/v1",
            "api_key_env": "GROQ_API_KEY",
            "label": "Groq",
            "embeddings_supported": false
        },
        {
            "id": "ollama-remote",
            "protocol": "openai_compat",
            "base_url": "http://192.168.1.50:11434/v1",
            "api_key_env": null,
            "label": "Ollama Remote",
            "default_embedding_model": "nomic-embed-text"
        }
    ],

    "AI_CONFIG": {
        "chat": {
            "connection": "google",
            "model_name": "gemini-3.5-flash",
            "generation_config": {
                "temperature": 1.0,
                "top_p": 0.95,
                "top_k": 64,
                "max_output_tokens": 8192
            },
            "safety_settings": [
                { "category": "HARM_CATEGORY_HARASSMENT", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_HATE_SPEECH", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_DANGEROUS_CONTENT", "threshold": "BLOCK_NONE" }
            ]
        },
        "summary": {
            "connection": "google",
            "model_name": "gemini-3.1-flash-lite",
            "generation_config": { "temperature": 0.7 },
            "safety_settings": [
                { "category": "HARM_CATEGORY_HARASSMENT", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_HATE_SPEECH", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_DANGEROUS_CONTENT", "threshold": "BLOCK_NONE" }
            ]
        },
        "knowledge": {
            "connection": "google",
            "model_name": "gemini-3.1-pro-preview",
            "generation_config": { "temperature": 1.0 },
            "safety_settings": [
                { "category": "HARM_CATEGORY_HARASSMENT", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_HATE_SPEECH", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_DANGEROUS_CONTENT", "threshold": "BLOCK_NONE" }
            ]
        },
        "embedding": {
            "connection": "google",
            "model_name": "gemini-embedding-2"
        },
        "gatekeeper": {
            "connection": "google",
            "model_name": "gemini-3.1-flash-lite",
            "generation_config": { "temperature": 0.0, "max_output_tokens": 512 },
            "safety_settings": [
                { "category": "HARM_CATEGORY_HARASSMENT", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_HATE_SPEECH", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT", "threshold": "BLOCK_NONE" },
                { "category": "HARM_CATEGORY_DANGEROUS_CONTENT", "threshold": "BLOCK_NONE" }
            ]
        }
    },

    "_AI_CONFIG_openai_example": {
        "_comment": "OpenAI を使う場合の設定例（このキーを AI_CONFIG にリネームして使用）",
        "chat": {
            "model_name": "gpt-4o",
            "generation_config": { "temperature": 1.0, "max_output_tokens": 8192 }
        },
        "summary": {
            "model_name": "gpt-4o-mini",
            "generation_config": { "temperature": 0.7 }
        },
        "knowledge": {
            "model_name": "gpt-4o",
            "generation_config": { "temperature": 1.0 }
        },
        "embedding": {
            "model_name": "gpt-4o-mini"
        },
        "gatekeeper": {
            "model_name": "gpt-4o-mini",
            "generation_config": { "temperature": 0.0, "max_output_tokens": 512 }
        }
    },

    "_AI_CONFIG_ollama_example": {
        "_comment": "Ollama（ローカル）を使う場合の設定例（このキーを AI_CONFIG にリネームして使用）",
        "chat": {
            "model_name": "ollama/llama3.1:8b",
            "generation_config": { "temperature": 1.0, "max_output_tokens": 8192 }
        },
        "summary": {
            "model_name": "ollama/llama3.1:8b",
            "generation_config": { "temperature": 0.7 }
        },
        "knowledge": {
            "model_name": "ollama/llama3.1:8b",
            "generation_config": { "temperature": 1.0 }
        },
        "embedding": {
            "model_name": "ollama/nomic-embed-text"
        },
        "gatekeeper": {
            "model_name": "ollama/llama3.1:8b",
            "generation_config": { "temperature": 0.0, "max_output_tokens": 512 }
        }
    },

    "_AI_CONFIG_xai_example": {
        "_comment": "xAI (Grok) を使う場合の設定例（このキーを AI_CONFIG にリネームして使用）",
        "chat": {
            "model_name": "grok-4-1-fast-reasoning",
            "generation_config": { "temperature": 1.0, "max_output_tokens": 8192 }
        },
        "summary": {
            "model_name": "grok-4-1-fast-non-reasoning",
            "generation_config": { "temperature": 0.7 }
        },
        "gatekeeper": {
            "model_name": "grok-4-1-fast-non-reasoning",
            "generation_config": { "temperature": 0.0, "max_output_tokens": 512 }
        }
    },

    "_AI_CONFIG_openai_reasoning_example": {
        "_comment": "OpenAI reasoning モデル (o3) の設定例。reasoning_effort: low/medium/high",
        "chat": {
            "model_name": "o3",
            "generation_config": { "max_output_tokens": 16384, "reasoning_effort": "medium" }
        }
    },

    "SYSTEM_CONFIG": {
        "agent": {
            "agent_name": "Butly",
            "user_name": "ユーザー"
        },
        "paths": {
            "db_name": "butly_memory.db",
            "system_instruction": "system_instruction.txt",
            "key_memory": "Key_Memory.txt"
        },
        "memory": {
            "max_raw_tokens": 4096,
            "raw_injection_format": "plaintext",
            "short_term_limit": 6
        },
        "brain": {
            "search_limit": 3,
            "keyword_hit_threshold": 5,
            "fallback_fetch_limit": 50,
            "summary_char_limit": 200,
            "readable_instances": ["self"],
            "dynamic_threshold": 0.6,
            "default_use_google_search": false
        },
        "backup": {
            "generations": 7,
            "dir_name": "db_backups"
        }
    }
}
