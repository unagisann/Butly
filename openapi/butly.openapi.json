              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Backend is not ready"
          }
        },
        "security": [
          {
            "DesktopToken": []
          }
        ],
        "summary": "Get chat message history",
        "tags": [
          "instances"
        ]
      }
