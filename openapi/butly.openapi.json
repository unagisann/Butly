    "/api/v1/instances/{name}/messages": {
      "get": {
        "description": "instance の会話履歴を時系列（古い順）で返す。legacy `GET /history/{name}` のversioned 置換で、timestamp と last_interaction_at を追加する。`before` cursor は予約のみで現時点では無視される（next_cursor も常に null）。",
        "operationId": "list_instance_messages",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "返す最大 message 数",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "返す最大 message 数",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "pagination cursor（予約。現行 storage では未実装のため無視される）",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "pagination cursor（予約。現行 storage では未実装のため無視される）",
              "title": "Before"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Instance not found"
