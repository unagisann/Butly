# ============================================================
# Butly — 環境変数設定
# 使用するプロバイダーに応じて必要なキーを設定してください。
# ============================================================

# --- Google Gemini ---
# model_name が "gemini-*" または "models/gemini-*" の場合に必要
GOOGLE_API_KEY=your_google_api_key_here

# --- OpenAI ---
# model_name が "gpt-*", "o1", "o3", "o4" の場合に必要
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # カスタムエンドポイント（任意）

# --- Ollama ---
# model_name が "ollama/*" の場合に使用（ローカル実行）
# デフォルト: http://localhost:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
