# ============================================================
# Butly — 環境変数設定
# 使用するプロバイダーに応じて必要なキーを設定してください。
# ============================================================

# --- Google Gemini ---
# model_name が "gemini-*" または "models/gemini-*" の場合に必要
GOOGLE_API_KEY=your_google_api_key_here

# --- OpenAI ---
# model_name が "gpt-*", "o1", "o3", "o4" の場合に必要
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # カスタムエンドポイント（任意）

# --- Ollama ---
# model_name が "ollama/*" の場合に使用（ローカル実行）
# デフォルト: http://localhost:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Web Search (Tavily) ---
# OpenAI/Ollama使用時のWeb検索に必要（Geminiは Native Grounding を使用）
# https://tavily.com で無料APIキーを取得できます（月1,000リクエスト）
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ============================================================
# 外部チャット連携（Discord / LINE）
# 連携を使う場合のみ設定。未設定なら該当 adapter は無効のままでよい。
# これらの token / secret は秘匿情報なので debug log には出力しないこと。
# ============================================================

# --- Discord Bot ---
# Discord Developer Portal で発行した Bot Token
# 起動: pip install -r requirements-discord.txt && python run_discord_bot.py
# 注意: メンション本文を読むには Developer Portal の Bot 設定で
#       "Message Content Intent" を有効化すること（privileged intent）。
# DISCORD_BOT_TOKEN=your_discord_bot_token_here
# 任意: 指定した guild に slash command を即時 sync（手動テスト用）。
#       未指定なら global sync（反映に最大 1 時間かかることがある）。
# DISCORD_DEV_GUILD_ID=your_guild_id_here
# 任意: 1/true/on にすると、/butly bind scope:channel したチャンネルでは
#       mention なしの全メッセージにも反応する（案B opt-in）。既定は mention のみ。
# DISCORD_RESPOND_IN_BOUND_CHANNELS=0
# 任意: 1/true/on で受信メッセージの診断ログを出す（mention 検出の確認用）。
# DISCORD_DEBUG_MESSAGES=0

# --- LINE Messaging API ---
# LINE Developers コンソールの「Messaging API」チャネルから取得
# LINE_CHANNEL_SECRET=your_line_channel_secret_here
# LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
